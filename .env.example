# MongoDB Configuration
# For local MongoDB (default):
MONGO_URI=mongodb://localhost:27017/delivery_digital
# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/delivery_digital?retryWrites=true&w=majority

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-database-password

# Server Configuration
PORT=3008
NODE_ENV=development
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# API Configuration
VITE_API_URL=https://421fbb351d6c.ngrok.app
# For production or external API:

# SMTP Configuration for Email Sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=contact@deliverydigital.fr